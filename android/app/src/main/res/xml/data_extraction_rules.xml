<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all data from cloud extraction -->
        <exclude path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude all data from device-to-device migration -->
        <exclude path="." />
    </device-transfer>
</data-extraction-rules>
